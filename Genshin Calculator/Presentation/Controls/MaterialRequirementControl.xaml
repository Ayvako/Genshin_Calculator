<UserControl
    x:Class="Genshin_Calculator.Presentation.Controls.MaterialRequirementControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button
        Padding="0"
        Background="Transparent"
        BorderThickness="0"
        Command="{Binding DataContext.OpenAddItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
        CommandParameter="{Binding TargetMaterial}"
        Cursor="Hand">

        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border
                    x:Name="Root"
                    Width="64"
                    Height="64"
                    Margin="4"
                    Background="{Binding TargetMaterial.Rarity, Converter={StaticResource RarityToBrushConverter}}"
                    BorderBrush="#2F323A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Opacity="{Binding IsCollected, Converter={StaticResource BoolToOpacityConverter}}">

                    <Grid>

                        <!--  Внутренний контейнер  -->
                        <Border
                            Margin="3"
                            Background="#22000000"
                            ClipToBounds="True"
                            CornerRadius="8">

                            <!--  ВАЖНО: НЕ РАСТЯГИВАЕМ  -->
                            <Viewbox Stretch="Uniform">
                                <Image RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding TargetMaterial.ImagePath}" />
                            </Viewbox>
                        </Border>

                        <!--  Количество  -->
                        <Border
                            Margin="4"
                            Padding="4,1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Background="#AA000000"
                            CornerRadius="6">

                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="White">

                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding MissingAmount}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCollected}" Value="True">
                                                <Setter Property="Text" Value="{Binding TargetMaterial.Amount}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>
                        </Border>

                        <!--  Галочка  -->
                        <Grid
                            Margin="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Visibility="{Binding IsCollected, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <Ellipse
                                Width="18"
                                Height="18"
                                Fill="#EEFFFFFF">
                                <Ellipse.Effect>
                                    <DropShadowEffect
                                        BlurRadius="4"
                                        Opacity="0.4"
                                        ShadowDepth="1" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#2ECC71"
                                Text="✔" />
                        </Grid>

                    </Grid>
                </Border>

                <!--  Hover эффект  -->
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Root" Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </ControlTemplate.Triggers>

            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>