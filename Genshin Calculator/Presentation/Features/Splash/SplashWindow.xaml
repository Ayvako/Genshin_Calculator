<Window
    x:Class="Genshin_Calculator.Presentation.Features.Splash.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Loading"
    Width="400"
    Height="200"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Border Background="#1a1a2e" CornerRadius="12">
        <StackPanel Margin="30" VerticalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                Foreground="White"
                Text="Genshin Calculator" />
            <TextBlock
                x:Name="StatusText"
                Margin="0,12,0,8"
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="#aaaaaa"
                Text="Starting..." />
            <ProgressBar
                x:Name="ProgressBar"
                Height="6"
                Background="#333"
                BorderThickness="0"
                Foreground="#c0a060"
                Maximum="100"
                Minimum="0" />
        </StackPanel>
    </Border>
</Window>