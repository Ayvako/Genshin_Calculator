<Window
    x:Class="Genshin_Calculator.Presentation.Features.Inventory.InventoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Genshin_Calculator.Presentation.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Genshin_Calculator.Presentation.Helpers"
    xmlns:inventory="clr-namespace:Genshin_Calculator.Presentation.Features.Inventory"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    Title="Inventory Manager"
    Width="1060"
    Height="780"
    MinWidth="880"
    MinHeight="650"
    d:DataContext="{d:DesignInstance Type=inventory:InventoryViewModel}"
    Background="#0D0E14"
    FontFamily="Segoe UI"
    TextElement.Foreground="#EAE6D8"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>

        <!--  ═══ Brushes ═══  -->
        <LinearGradientBrush x:Key="WindowBgBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#0D0E14" />
            <GradientStop Offset="1" Color="#111318" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#1A1C24" />
            <GradientStop Offset="1" Color="#14151C" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderGoldBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#C8A84B" />
            <GradientStop Offset="0.5" Color="#E8D07A" />
            <GradientStop Offset="1" Color="#C8A84B" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBtnBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#3A8C5C" />
            <GradientStop Offset="1" Color="#4DB87A" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CancelBtnBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#8C3A3A" />
            <GradientStop Offset="1" Color="#C05050" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardTopLightBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="White" />
            <GradientStop Offset="1" Color="Transparent" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="GoldAccentBrush" Color="#C8A84B" />
        <SolidColorBrush x:Key="GoldSubtleBrush" Color="#4A3D1A" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2E3140" />
        <SolidColorBrush x:Key="InputBgBrush" Color="#1E2030" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8A8FA8" />

        <!--  ═══ Typography ═══  -->
        <Style x:Key="WindowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource HeaderGoldBrush}" />
        </Style>

        <Style x:Key="WindowSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4B86A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  ═══ Cards ═══  -->
        <Style x:Key="InventoryCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="Background" Value="#2A2D3A" />
            <Setter Property="Margin" Value="5" />
        </Style>

        <!--  ═══ Amount TextBox ═══  -->
        <Style x:Key="AmountBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#FEFEFE" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CaretBrush" Value="#C8A84B" />
        </Style>

        <!--  ═══ Search TextBox ═══  -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#D0D4E0" />
            <Setter Property="Background" Value="{StaticResource InputBgBrush}" />
            <Setter Property="BorderBrush" Value="#2E3140" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CaretBrush" Value="#C8A84B" />
            <Setter Property="SelectionBrush" Value="#4A3D1A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#C8A84B" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#5A5E70" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ═══ Scrollbar ═══  -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border
                            Margin="2,0"
                            Background="#3A3E55"
                            CornerRadius="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ═══ Action Buttons ═══  -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform CenterX="60" CenterY="20" ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ═══ Divider ═══  -->
        <Style x:Key="GoldDividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{StaticResource HeaderGoldBrush}" />
            <Setter Property="Margin" Value="0,10,0,14" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>

    </Window.Resources>

    <!--
        ═══════════════════════════════════════
        ROOT
        ════════════════════════════════════════
    -->
    <Grid Background="{StaticResource WindowBgBrush}">

        <!--  Outer glow border  -->
        <Border
            Margin="14"
            Background="{StaticResource PanelBrush}"
            BorderBrush="#2A2E40"
            BorderThickness="1"
            CornerRadius="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!--  Header  -->
                    <RowDefinition Height="Auto" />
                    <!--  Divider  -->
                    <RowDefinition Height="Auto" />
                    <!--  Toolbar  -->
                    <RowDefinition Height="*" />
                    <!--  Content  -->
                    <RowDefinition Height="Auto" />
                    <!--  Footer  -->
                </Grid.RowDefinitions>

                <!--  ── HEADER ──  -->
                <Grid Grid.Row="0" Margin="22,20,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Title block  -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Border
                                Width="28"
                                Height="28"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#C8A84B" />
                                        <GradientStop Offset="1" Color="#E8D07A" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <RotateTransform Angle="45" CenterX="14" CenterY="14" />
                                </Border.RenderTransform>
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource WindowTitleStyle}"
                                Text="INVENTORY" />
                        </StackPanel>
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource CancelBtnBrush}"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="✖" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!--  ── GOLD DIVIDER ──  -->
                <Rectangle
                    Grid.Row="1"
                    Margin="22,12,22,0"
                    Style="{StaticResource GoldDividerStyle}" />

                <!--  ── TOOLBAR: Search + Filter ──  -->
                <Grid Grid.Row="2" Margin="22,0,22,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <!--  Filter ComboBox  -->
                    <ComboBox
                        Grid.Column="2"
                        Padding="12,8"
                        VerticalAlignment="Center"
                        Background="{StaticResource InputBgBrush}"
                        BorderBrush="#2E3140"
                        BorderThickness="1"
                        Foreground="#D0D4E0"
                        ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                        ItemsSource="{Binding FilterOptions}"
                        SelectedItem="{Binding SelectedFilter}"
                        Style="{StaticResource ComboBoxStyle}" />
                </Grid>

                <!--  ── CONTENT: Material Cards ──  -->

                <ListView
                    Grid.Row="3"
                    Padding="16,0,16,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding MaterialsView}"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Page" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <!--  Group headers  -->
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Margin" Value="0,0,0,16" />
                                </Style>
                            </GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,10,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Gold left accent bar  -->
                                        <Border
                                            Grid.Column="0"
                                            Width="3"
                                            Margin="0,0,10,0"
                                            CornerRadius="2">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#E8D07A" />
                                                    <GradientStop Offset="1" Color="#6A5018" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Vertical">
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding Name}" />
                                            <Rectangle
                                                Height="1"
                                                Margin="0,5,0,0"
                                                Fill="#2E3140" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>

                    <!--  Item template  -->
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="80"
                                Height="108"
                                Background="{Binding Rarity, Converter={StaticResource RarityToBrushConverter}}"
                                Style="{StaticResource InventoryCardStyle}"
                                ToolTipService.InitialShowDelay="150"
                                ToolTipService.ShowDuration="60000">

                                <!--  Tooltip  -->
                                <Border.ToolTip>
                                    <ToolTip
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Placement="Mouse">
                                        <Border
                                            Width="230"
                                            Padding="14"
                                            Background="#16182A"
                                            BorderBrush="#3A3E55"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="20"
                                                    Opacity="0.8"
                                                    ShadowDepth="0"
                                                    Color="Black" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <!--  Name header  -->
                                                <Border
                                                    Margin="0,0,0,10"
                                                    Padding="8"
                                                    Background="{Binding Rarity, Converter={StaticResource RarityToBrushConverter}}"
                                                    CornerRadius="8">
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Text="{Binding Name}"
                                                        TextAlignment="Center"
                                                        TextWrapping="Wrap" />
                                                </Border>

                                                <!--  Quantity row  -->
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{StaticResource MutedTextBrush}"
                                                        Text="Quantity" />
                                                    <Rectangle
                                                        Grid.Column="1"
                                                        Height="1"
                                                        Margin="8,0"
                                                        VerticalAlignment="Center"
                                                        Fill="#2A2E40" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="#E8D07A"
                                                        Text="{Binding Amount}" />
                                                </Grid>

                                                <!--  Rarity row  -->
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{StaticResource MutedTextBrush}"
                                                        Text="Rarity" />
                                                    <Rectangle
                                                        Grid.Column="1"
                                                        Height="1"
                                                        Margin="8,0"
                                                        VerticalAlignment="Center"
                                                        Fill="#2A2E40" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="#E8D07A"
                                                        Text="{Binding Rarity}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </ToolTip>
                                </Border.ToolTip>

                                <!--  Card body  -->
                                <Grid>
                                    <!--  Subtle inner top-light effect  -->
                                    <Border
                                        Height="30"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource CardTopLightBrush}"
                                        CornerRadius="10,10,0,0"
                                        Opacity="0.18" />

                                    <!--  Item image  -->
                                    <Image
                                        Width="58"
                                        Height="58"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        RenderOptions.BitmapScalingMode="LowQuality"
                                        Source="{Binding ImagePath, Converter={StaticResource CachedImageConverter}}" />

                                    <!--  Amount input  -->
                                    <Border
                                        Margin="8,0,8,8"
                                        Padding="4,3"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="6">
                                        <Border.Background>
                                            <SolidColorBrush Opacity="0.55" Color="#000000" />
                                        </Border.Background>
                                        <TextBox
                                            helpers:TextBoxExtensions.NumericOnly="True"
                                            Style="{StaticResource AmountBoxStyle}"
                                            Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  ── FOOTER ──  -->
                <Border
                    Grid.Row="4"
                    Margin="0,12,0,0"
                    Padding="22,14,22,18"
                    BorderBrush="#22253A"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Buttons  -->
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">

                            <Button
                                Width="130"
                                Height="40"
                                Padding="14,0"
                                Background="{StaticResource SaveBtnBrush}"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource ActionButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="✔" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="Сохранить" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>