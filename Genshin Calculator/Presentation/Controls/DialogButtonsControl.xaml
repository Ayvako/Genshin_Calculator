<UserControl
    x:Class="Genshin_Calculator.Presentation.Controls.DialogButtonsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel
        Margin="0,15,0,0"
        HorizontalAlignment="Center"
        Orientation="Horizontal">
        <Button
            Width="35"
            Height="35"
            Margin="0,0,15,0"
            Background="{StaticResource CancelActionBrush}"
            Command="{Binding CancelCommand}"
            Content="✖"
            Foreground="White"
            IsCancel="True"
            Style="{StaticResource RoundShadowButtonStyle}" />

        <Button
            Width="35"
            Height="35"
            Margin="15,0,0,0"
            Background="{StaticResource SuccessActionBrush}"
            Command="{Binding SaveCommand}"
            Content="✔"
            Foreground="White"
            IsDefault="True"
            Style="{StaticResource RoundShadowButtonStyle}" />
    </StackPanel>
</UserControl>