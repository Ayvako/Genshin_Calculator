<UserControl
    x:Class="Genshin_Calculator.Presentation.Features.Characters.Components.LevelSelectorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:сomponents="clr-namespace:Genshin_Calculator.Presentation.Features.Characters.Components"
    x:Name="root"
    d:DataContext="{d:DesignInstance Type=сomponents:LevelSelectorControl}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="LevelActionButtonStyle"
            BasedOn="{StaticResource RoundedButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style
            x:Key="LevelValueButtonStyle"
            BasedOn="{StaticResource RoundedButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="70" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Center">
        <TextBlock
            Margin="0,0,0,4"
            HorizontalAlignment="Center"
            FontSize="12"
            Foreground="#AAA"
            Text="{Binding Title, ElementName=root}" />

        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

            <Button
                Command="{Binding DecreaseLevelCommand, ElementName=root}"
                IsEnabled="{Binding Level, ElementName=root, Converter={StaticResource GreaterThanConverter}, ConverterParameter=1}"
                Style="{StaticResource LevelActionButtonStyle}">
                <TextBlock
                    Margin="0,-8,0,0"
                    FontSize="28"
                    Text="-" />
            </Button>

            <ToggleButton
                x:Name="TogglePopupButton"
                IsChecked="{Binding IsPopupOpen, ElementName=root, Mode=TwoWay}"
                PreviewMouseLeftButtonDown="TogglePopupButtonPreviewMouseLeftButtonDown"
                Style="{StaticResource LevelToggleButtonStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="#2C2C2C"
                        Text="{Binding Level, ElementName=root}" />

                    <Rectangle
                        Grid.Row="1"
                        Height="1"
                        Fill="#C4B8A8" />

                    <TextBlock
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="6"
                        Foreground="#666666"
                        Text="▼" />
                </Grid>
            </ToggleButton>

            <Popup
                x:Name="LevelPopup"
                AllowsTransparency="True"
                Focusable="False"
                IsOpen="{Binding IsPopupOpen, ElementName=root}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=TogglePopupButton}"
                PopupAnimation="None">

                <Border
                    Padding="6"
                    Background="#1E1E1E"
                    BorderBrush="#444"
                    BorderThickness="1"
                    CornerRadius="6"
                    SnapsToDevicePixels="True">

                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding LevelRows, ElementName=root}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Button
                                            Command="{Binding SelectLevelCommand, ElementName=root}"
                                            CommandParameter="{Binding Left}"
                                            Content="{Binding Left}"
                                            Style="{StaticResource LevelValueButtonStyle}" />

                                        <Button
                                            Margin="6,0,0,0"
                                            Command="{Binding SelectLevelCommand, ElementName=root}"
                                            CommandParameter="{Binding Right}"
                                            Content="{Binding Right}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource LevelValueButtonStyle}" TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Right}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>

            <Button
                Command="{Binding IncreaseLevelCommand, ElementName=root}"
                IsEnabled="{Binding Level, ElementName=root, Converter={StaticResource LevelLessThanConverter}, ConverterParameter=100}"
                Style="{StaticResource LevelActionButtonStyle}">
                <TextBlock
                    Margin="0,-8,0,0"
                    FontSize="28"
                    Text="+" />
            </Button>

        </StackPanel>
    </StackPanel>
</UserControl>