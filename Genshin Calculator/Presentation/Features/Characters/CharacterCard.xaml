<UserControl
    x:Class="Genshin_Calculator.Presentation.Features.Characters.Components.CharacterCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:characters="clr-namespace:Genshin_Calculator.Presentation.Features.Characters"
    xmlns:controls="clr-namespace:Genshin_Calculator.Presentation.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="380"
    MinWidth="350"
    MaxWidth="720"
    Margin="6"
    d:DataContext="{d:DesignInstance Type=characters:CharacterCardViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DropShadowEffect
            x:Key="CardShadow"
            BlurRadius="18"
            Direction="270"
            Opacity="0.45"
            ShadowDepth="0"
            Color="Black" />

        <DropShadowEffect
            x:Key="RarityGlowEffect"
            BlurRadius="14"
            Direction="270"
            Opacity="0.50"
            ShadowDepth="0"
            Color="#C8A865" />

        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CBBFA9" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        </Style>

        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#1F2228" />
            <Setter Property="BorderBrush" Value="#343840" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <Style x:Key="TalentDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="#2A2D34" />
        </Style>
    </UserControl.Resources>

    <Grid Effect="{StaticResource CardShadow}">

        <Border
            x:Name="Root"
            Margin="1"
            Background="#181A1F"
            BorderThickness="1"
            CornerRadius="16">

            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#3A3D46" />
                    <GradientStop Offset="1" Color="#1C1E24" />
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <Border
                    Grid.Row="0"
                    Background="{Binding Character.Assets.Rarity, Converter={StaticResource RarityToBrushConverter}}"
                    CornerRadius="16,16,0,0">
                    <Grid Margin="10,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,8,0"
                                Command="{Binding EditCommand}"
                                Style="{StaticResource IconButtonStyle}">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Kind="PencilOutline" />
                            </Button>
                            <Button Command="{Binding AscendCommand}" Style="{StaticResource IconButtonStyle}">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Kind="StarOutline" />
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding Name, FallbackValue=Title}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,8,0"
                                Command="{Binding ToggleActiveCommand}"
                                Style="{StaticResource IconButtonStyle}">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Kind="Power" />
                            </Button>
                            <Button Command="{Binding RemoveCommand}" Style="{StaticResource IconButtonStyle}">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Kind="DeleteOutline" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="0"
                    Height="1"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#00C8A865" />
                            <GradientStop Offset="0.5" Color="#90C8A865" />
                            <GradientStop Offset="1" Color="#00C8A865" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!--  Main content  -->
                <Grid Grid.Row="1" Margin="12,12,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Portrait  -->
                    <Grid
                        Width="104"
                        Height="104"
                        ClipToBounds="False">
                        <Border
                            Background="{Binding Assets.Rarity, Converter={StaticResource RarityToBrushConverter}}"
                            CornerRadius="14"
                            Effect="{StaticResource RarityGlowEffect}" />

                        <Border
                            Margin="3"
                            ClipToBounds="True"
                            CornerRadius="14">
                            <Border.Background>
                                <ImageBrush
                                    ImageSource="{Binding Assets.ImagePath}"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="14" IsHitTestVisible="False">
                            <Border.Background>
                                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                                    <GradientStop Offset="0.5" Color="#00000000" />
                                    <GradientStop Offset="1.0" Color="#55000000" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!--  Stats  -->
                    <Border
                        Grid.Column="1"
                        Margin="12,2,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource PillStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Column headings  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,0,2"
                                Style="{StaticResource InfoLabelStyle}"
                                Text="Current" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="3"
                                Margin="0,0,0,2"
                                Style="{StaticResource InfoLabelStyle}"
                                Text="Target" />

                            <!--  Character level  -->
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                Style="{StaticResource InfoValueStyle}"
                                Text="{Binding CurrentLevel, FallbackValue=1}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="#6B6659"
                                Text="→" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                Foreground="#C8A865"
                                Style="{StaticResource InfoValueStyle}"
                                Text="{Binding DesiredLevel, FallbackValue=90}" />

                            <Border
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Margin="0,6,0,0"
                                Style="{StaticResource TalentDividerStyle}" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Margin="0,4,0,4"
                                Style="{StaticResource InfoLabelStyle}"
                                Text="Talents" />

                            <!--  Auto Attack  -->
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#7A8FA8"
                                Text="Attack"
                                Typography.Capitals="AllSmallCaps" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                Style="{StaticResource InfoValueStyle}"
                                Text="{Binding AutoAttack.CurrentLevel, FallbackValue=1}" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="2"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="#6B6659"
                                Text="→" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                Foreground="#C8A865"
                                Style="{StaticResource InfoValueStyle}"
                                Text="{Binding AutoAttack.DesiredLevel, FallbackValue=10}" />

                            <Border
                                Grid.Row="5"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Margin="0,4"
                                Style="{StaticResource TalentDividerStyle}" />

                            <!--  Elemental Skill  -->
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#7A8FA8"
                                Text="Skill"
                                Typography.Capitals="AllSmallCaps" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                Style="{StaticResource InfoValueStyle}"
                                Text="{Binding Elemental.CurrentLevel, FallbackValue=1}" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="2"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="#6B6659"
                                Text="→" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                Foreground="#C8A865"
                                Style="{StaticResource InfoValueStyle}"
                                Text="{Binding Elemental.DesiredLevel, FallbackValue=10}" />

                            <Border
                                Grid.Row="7"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Margin="0,4"
                                Style="{StaticResource TalentDividerStyle}" />

                            <!--  Burst  -->
                            <TextBlock
                                Grid.Row="8"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#7A8FA8"
                                Text="Burst"
                                Typography.Capitals="AllSmallCaps" />
                            <TextBlock
                                Grid.Row="8"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                Style="{StaticResource InfoValueStyle}"
                                Text="{Binding Burst.CurrentLevel, FallbackValue=1}" />
                            <TextBlock
                                Grid.Row="8"
                                Grid.Column="2"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="#6B6659"
                                Text="→" />
                            <TextBlock
                                Grid.Row="8"
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                Foreground="#C8A865"
                                Style="{StaticResource InfoValueStyle}"
                                Text="{Binding Burst.DesiredLevel, FallbackValue=10}" />
                        </Grid>
                    </Border>

                </Grid>

                <!--  Resources  -->
                <Border
                    Grid.Row="2"
                    Margin="12,0,12,12"
                    Padding="8"
                    Background="#20232A"
                    BorderBrush="#2D3139"
                    BorderThickness="1"
                    CornerRadius="14"
                    Visibility="{Binding HasItems, ElementName=MaterialsList, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl x:Name="MaterialsList" ItemsSource="{Binding RequiredMaterials}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:MaterialRequirementControl Margin="4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </Grid>
        </Border>

        <!--  Inactive overlay  -->
        <Border
            Panel.ZIndex="1000"
            Background="#88000000"
            CornerRadius="16"
            IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActivated}" Value="False">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>