<Window
    x:Class="Genshin_Calculator.Presentation.Features.Dialogs.UpgradeCharacterDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Genshin_Calculator.Presentation.Controls"
    Title="Upgrade Character"
    Width="480"
    Height="580"
    MinWidth="420"
    MinHeight="440"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Segoe UI"
    SnapsToDevicePixels="True"
    TextElement.Foreground="#EAE6D8"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <Window.Resources>

        <!--  ═══ Brushes ═══  -->
        <LinearGradientBrush x:Key="DialogBgBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#16182A" />
            <GradientStop Offset="1" Color="#0F1018" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderGoldBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#C8A84B" />
            <GradientStop Offset="0.5" Color="#E8D07A" />
            <GradientStop Offset="1" Color="#C8A84B" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBtnBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#3A8C5C" />
            <GradientStop Offset="1" Color="#4DB87A" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CancelBtnBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#8C3A3A" />
            <GradientStop Offset="1" Color="#C05050" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="GoldAccentBrush" Color="#C8A84B" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="SectionBgBrush" Color="#111320" />

        <!--  ═══ Shadows ═══  -->
        <DropShadowEffect
            x:Key="WindowShadow"
            BlurRadius="40"
            Opacity="0.75"
            ShadowDepth="6"
            Color="Black" />
        <DropShadowEffect
            x:Key="GoldGlow"
            BlurRadius="14"
            Opacity="0.45"
            ShadowDepth="0"
            Color="#C8A84B" />
        <DropShadowEffect
            x:Key="CardShadow"
            BlurRadius="10"
            Opacity="0.55"
            ShadowDepth="0"
            Color="Black" />
        <DropShadowEffect
            x:Key="BtnShadow"
            BlurRadius="16"
            Opacity="0.55"
            ShadowDepth="2"
            Color="Black" />
        <DropShadowEffect
            x:Key="GreenGlow"
            BlurRadius="14"
            Opacity="0.5"
            ShadowDepth="0"
            Color="#3A8C5C" />

        <!--  ═══ Scrollbar ═══  -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border
                            Margin="2,0"
                            Background="#3A3E55"
                            CornerRadius="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ═══ Action button ═══  -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Effect" Value="{StaticResource BtnShadow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ═══ Section label ═══  -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#C8A84B" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

    </Window.Resources>

    <!--
        ══════════════════════════════════
        ROOT
        ══════════════════════════════════
    -->
    <Border
        Background="{StaticResource DialogBgBrush}"
        BorderBrush="#2A2E45"
        BorderThickness="1"
        CornerRadius="16"
        Effect="{StaticResource WindowShadow}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Header  -->
                <RowDefinition Height="*" />
                <!--  Scroll body  -->
                <RowDefinition Height="Auto" />
                <!--  Footer  -->
            </Grid.RowDefinitions>

            <!--  ══ HEADER ══  -->
            <Border
                Grid.Row="0"
                Padding="22,18,22,16"
                BorderBrush="#22263A"
                BorderThickness="0,0,0,1"
                CornerRadius="16,16,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#1C1F30" />
                        <GradientStop Offset="1" Color="#14172A" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Diamond icon  -->
                    <Border
                        Grid.Column="0"
                        Width="22"
                        Height="22"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#C8A84B" />
                                <GradientStop Offset="1" Color="#E8D07A" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <RotateTransform Angle="45" CenterX="11" CenterY="11" />
                        </Border.RenderTransform>
                    </Border>

                    <!--  Title + subtitle  -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Effect="{StaticResource GoldGlow}"
                            FontSize="16"
                            FontWeight="Bold">
                            <TextBlock.Text>
                                <Binding
                                    FallbackValue="CHARACTER UPGRADE"
                                    Path="Character.Name"
                                    StringFormat="UPGRADE — {0}" />
                            </TextBlock.Text>
                            <TextBlock.Foreground>
                                <Binding
                                    Converter="{StaticResource RarityToBrushConverter}"
                                    FallbackValue="#E8D07A"
                                    Path="Character.Assets.Rarity" />
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ══ SCROLL BODY ══  -->
            <ScrollViewer
                Grid.Row="1"
                Padding="18,0,18,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!--  ── Required materials ──  -->
                    <StackPanel Margin="0,18,0,0">
                        <StackPanel
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <Rectangle
                                Width="40"
                                Height="1"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="Transparent" />
                                        <GradientStop Offset="1" Color="#C8A84B" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock
                                Margin="0"
                                Style="{StaticResource SectionLabelStyle}"
                                Text="REQUIRED MATERIALS" />
                            <Rectangle
                                Width="40"
                                Height="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#C8A84B" />
                                        <GradientStop Offset="1" Color="Transparent" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Materials}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Margin="5"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.OpenAddItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding TargetMaterial}"
                                        Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="CardBorder"
                                                    Width="64"
                                                    Height="84"
                                                    Background="{Binding TargetMaterial.Rarity, Converter={StaticResource RarityToBrushConverter}}"
                                                    BorderBrush="#2E3140"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Effect="{StaticResource CardShadow}"
                                                    Opacity="{Binding IsCollected, Converter={StaticResource BoolToOpacityConverter}}">

                                                    <Grid>
                                                        <!--  Inner top highlight  -->
                                                        <Border
                                                            Height="22"
                                                            VerticalAlignment="Top"
                                                            CornerRadius="10,10,0,0"
                                                            Opacity="0.18">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Offset="0" Color="White" />
                                                                    <GradientStop Offset="1" Color="Transparent" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <!--  Amount / Missing badge  -->
                                                        <Border
                                                            Height="22"
                                                            VerticalAlignment="Top"
                                                            Background="#BB000000"
                                                            CornerRadius="9,9,0,0">
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="White">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding MissingAmount}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCollected}" Value="True">
                                                                                <Setter Property="Text" Value="{Binding TargetMaterial.Amount}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding CraftedAmount, Converter={StaticResource GreaterThanConverter}, ConverterParameter=0}" Value="True">
                                                                                <Setter Property="ToolTip" Value="{Binding CraftedAmount}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <!--  Item image  -->
                                                        <Image
                                                            Margin="6,26,6,6"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Source="{Binding TargetMaterial.ImagePath}"
                                                            Stretch="Uniform" />

                                                        <!--  Collected checkmark badge  -->
                                                        <Grid
                                                            Margin="0,0,-3,-3"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Visibility="{Binding IsCollected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Ellipse
                                                                Width="20"
                                                                Height="20"
                                                                Fill="#1A1C28"
                                                                Stroke="#4CAF50"
                                                                StrokeThickness="1.5" />
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="11"
                                                                FontWeight="Bold"
                                                                Foreground="#4CAF50"
                                                                Text="&#xE73E;" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="#C8A84B" />
                                                        <Setter TargetName="CardBorder" Property="Opacity" Value="0.82" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="CardBorder" Property="Opacity" Value="0.65" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!--  ── Crafting section ──  -->
                    <StackPanel Margin="0,22,0,16">

                        <!--  Section header with divider  -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Rectangle
                                Grid.Column="0"
                                Height="1"
                                VerticalAlignment="Center">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="Transparent" />
                                        <GradientStop Offset="1" Color="#3A3E55" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Border
                                Grid.Column="1"
                                Margin="10,0"
                                Padding="14,6"
                                Background="{StaticResource SectionBgBrush}"
                                BorderBrush="#2E3140"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0"
                                        Style="{StaticResource SectionLabelStyle}"
                                        Text="CRAFT" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="Basic materials" />
                                </StackPanel>
                            </Border>

                            <Rectangle
                                Grid.Column="2"
                                Height="1"
                                VerticalAlignment="Center">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#3A3E55" />
                                        <GradientStop Offset="1" Color="Transparent" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>

                        <!--  Craft cards  -->
                        <ItemsControl ItemsSource="{Binding MaterialsToCraft}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Margin="4"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.OpenAddItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="CraftBorder"
                                                    Width="58"
                                                    Height="74"
                                                    Background="{Binding Rarity, Converter={StaticResource RarityToBrushConverter}}"
                                                    BorderBrush="#2E3140"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Effect="{StaticResource CardShadow}">

                                                    <Grid>
                                                        <!--  Inner top highlight  -->
                                                        <Border
                                                            Height="18"
                                                            VerticalAlignment="Top"
                                                            CornerRadius="10,10,0,0"
                                                            Opacity="0.16">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Offset="0" Color="White" />
                                                                    <GradientStop Offset="1" Color="Transparent" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <!--  Amount badge  -->
                                                        <Border
                                                            Height="19"
                                                            VerticalAlignment="Top"
                                                            Background="#BB000000"
                                                            CornerRadius="9,9,0,0">
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="#E8D07A"
                                                                Text="{Binding Amount}" />
                                                        </Border>

                                                        <!--  Item image  -->
                                                        <Image
                                                            Margin="5,22,5,5"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Source="{Binding ImagePath}"
                                                            Stretch="Uniform" />
                                                    </Grid>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CraftBorder" Property="BorderBrush" Value="#C8A84B" />
                                                        <Setter TargetName="CraftBorder" Property="Opacity" Value="0.82" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="CraftBorder" Property="Opacity" Value="0.65" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!--  ══ FOOTER ══  -->
            <Border
                Grid.Row="2"
                Padding="22,14,22,18"
                BorderBrush="#22263A"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,16,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#14172A" />
                        <GradientStop Offset="1" Color="#0F1018" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Buttons  -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">

                        <Button
                            Width="115"
                            Height="40"
                            Margin="0,0,10,0"
                            Padding="12,0"
                            Background="{StaticResource CancelBtnBrush}"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                            Style="{StaticResource ActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="✖" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Text="Cancel" />
                            </StackPanel>
                        </Button>

                        <Button
                            Width="125"
                            Height="40"
                            Padding="12,0"
                            Background="{StaticResource SaveBtnBrush}"
                            Command="{Binding SaveCommand}"
                            IsDefault="True"
                            Style="{StaticResource ActionButtonStyle}">
                            <Button.Effect>
                                <DropShadowEffect
                                    BlurRadius="14"
                                    Opacity="0.5"
                                    ShadowDepth="0"
                                    Color="#3A8C5C" />
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="✔" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Text="Confirm" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>